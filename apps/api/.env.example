# Postgres (docker compose local: ver docker-compose.yml na raiz)
DATABASE_URL="postgresql://leilao:leilao@localhost:5433/leilao?schema=public"

# Porta do servidor Fastify
PORT=3000
NODE_ENV=development

# Origem permitida para CORS (frontend). Em produção, URL do deploy no Vercel.
CORS_ORIGIN="http://localhost:5173"

# Segredo para assinar os JWT de sessão. Gerar com: openssl rand -hex 32
JWT_SECRET="change-me-in-production"

# Segredo da cadeia de hash da auditoria (NUNCA fica no banco). Gerar com: openssl rand -hex 32
AUDIT_SECRET="change-me-in-production"

# Intervalo (ms) do worker que encerra e liquida lotes vencidos
WORKER_INTERVAL_MS=1500
